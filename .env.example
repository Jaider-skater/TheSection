# Copy to .deploy-secrets.env and fill in real values, then run:
#   python3 scripts/setup_production.py

# --- Required for setup script ---
# Full secret (sk_...) or restricted key (rk_test_... / rk_live_...)
# Restricted key needs at least:
#   Checkout Sessions: Write (create + read)
#   Webhook Endpoints: Write (only for setup script; can use dashboard instead)
STRIPE_SECRET_KEY=rk_test_or_sk_test_...
RENDER_API_KEY=rnd_...

# Optional: skip discovery if you already know the service id
# RENDER_SERVICE_ID=srv-...
RENDER_SERVICE_NAME=thesection

# Public app URL (webhook destination)
BASE_URL=https://thesection.onrender.com

# --- Secrets written to Render ---
# Leave blank to auto-generate strong values
SECRET_KEY=
ADMIN_KEY=

# Stripe webhook secret is created by the script and set on Render
# STRIPE_WEBHOOK_SECRET=whsec_...

# Mail (Gmail app password recommended)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Door scanner login
VERIFY_LOGIN_EMAIL=
VERIFY_LOGIN_PASSWORD=

# Optional member bootstrap after deploys
LEGACY_BOOTSTRAP_EMAIL=
LEGACY_BOOTSTRAP_PASSWORD=
